# Copy to /etc/channeled/channeled.env (Linux) or set as process env (Windows).
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=channeled;Username=channeled;Password=change-me
FileStore__Kind=FileSystem
FileStore__RootPath=/var/lib/channeled/object-store
Backup__RootPath=/var/lib/channeled/backups
Backup__AlertEmail=ops@example.com
Backup__LowDiskBytes=1073741824
Operations__PublicUrl=https://channeled.example
MigrateOnStartup=true
Maintenance__Enabled=false
