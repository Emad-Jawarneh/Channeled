# Copy to ops/docker/compose.env and edit before `docker compose --env-file … up`.
# Never commit compose.env (secrets).

# --- Postgres ------------------------------------------------------------
POSTGRES_DB=channeled
POSTGRES_USER=channeled
# Change before any real deployment.
POSTGRES_PASSWORD=channeled_dev_change_me

# --- HTTP ----------------------------------------------------------------
CHANNELED_HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

# --- Object store (default: filesystem volume on the api service) --------
FILE_STORE_KIND=FileSystem

# For MinIO profile (`docker compose --profile minio …`), also set:
# FILE_STORE_KIND=S3Compatible
# FILE_STORE_ENDPOINT=http://minio:9000
# FILE_STORE_BUCKET=channeled
# FILE_STORE_ACCESS_KEY=channeled
# FILE_STORE_SECRET_KEY=change-me-minio-secret-min-8-chars
# FILE_STORE_FORCE_PATH_STYLE=true
# MINIO_ROOT_USER=channeled
# MINIO_ROOT_PASSWORD=change-me-minio-secret-min-8-chars
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- App -----------------------------------------------------------------
BACKUP_ALERT_EMAIL=ops@example.com
PUBLIC_FILE_LINKS_ENABLED=false
# Required when enabling public file links (long random secret):
PUBLIC_FILE_LINKS_HMAC_KEY=
ACCOUNT_SELF_SERVICE_MAIL=Auto
CHAT_POSTS_PER_MINUTE=30
