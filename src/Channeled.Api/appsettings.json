{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MigrateOnStartup": true,
  "FileStore": {
    "Kind": "FileSystem",
    "RootPath": ".data/object-store"
  },
  "UploadLimits": {
    "MaxFileBytes": 10737418240,
    "PartSizeBytes": 8388608,
    "UploadSessionExpiryHours": 24,
    "TrashRetentionDays": 30
  },
  "SearchBench": {
    "P95MaxMilliseconds": 500,
    "DefaultSeedCount": 1000000
  },
  "Backup": {
    "RootPath": ".data/backups",
    "RetainDaily": 7,
    "RetainWeekly": 4,
    "RetainMonthly": 3,
    "PgDumpPath": "pg_dump",
    "PgRestorePath": "pg_restore",
    "LowDiskBytes": 1073741824,
    "RestoreViaAdmin": true
  },
  "Maintenance": {
    "Enabled": false
  },
  "Operations": {
    "PublicUrl": "http://localhost:5048"
  },
  "Account": {
    "SelfServiceMail": "Auto",
    "SessionCacheTtlSeconds": 5,
    "ForgotPasswordPerAddressPerHour": 3,
    "EmailChangePendingMinutes": 60,
    "CancelTokenHours": 24,
    "UsernameCooldownDays": 30
  },
  "Realtime": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5048",
      "http://127.0.0.1:5048"
    ],
    "MaxConnectionsPerUser": 10,
    "MaxGroupsPerConnection": 50,
    "MaxInboundMessageBytes": 8192,
    "CoalesceQuietMilliseconds": 250,
    "CoalesceMaxWaitMilliseconds": 2000,
    "AuthStateSweepSeconds": 10
  },
  "PublicFileLinks": {
    "Enabled": false,
    "HmacKey": "",
    "PreviousHmacKey": "",
    "DefaultExpiryDays": 7,
    "MaxExpiryDays": 30,
    "DefaultMaxDownloads": 3,
    "MaxFileBytes": 2147483648,
    "MaxActiveLinksPerTeam": 50,
    "TicketTtlHours": 2,
    "TicketByteCapMultiplier": 2,
    "PerStreamBytesPerSecond": 26214400,
    "GlobalAnonEgressBytesPerSecond": 104857600,
    "MaxGlobalAnonStreams": 32,
    "MaxAnonStreamsPerIp": 4,
    "ClaimIdempotencySeconds": 60,
    "MidStreamRecheckSeconds": 5
  },
  "Chat": {
    "PostsPerMinutePerUser": 30,
    "DeletedRetentionDays": 30,
    "PurgeIntervalHours": 24
  },
  "ChannelDelete": {
    "MaxFilesPerTxn": 10000,
    "MaxMessagesPerTxn": 10000,
    "MaxFilesPerTeamDelete": 50000,
    "MaxMessagesPerTeamDelete": 50000,
    "MaxItemsPerTrash": 10000,
    "ObjectDeleteChunkSize": 2000,
    "LockTimeout": "5s",
    "StatementTimeout": "60s",
    "ObjectDeleteMaxAttempts": 8
  },
  "UserDelete": {
    "SweepIntervalSeconds": 60,
    "LatePhaseGraceSeconds": 30
  },
  "DisableBackgroundJobs": false
}
