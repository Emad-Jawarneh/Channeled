{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MigrateOnStartup": true,
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=channeled;Username=channeled;Password=channeled_dev"
  },
  "FileStore": {
    "Kind": "FileSystem",
    "RootPath": ".data/object-store"
  },
  "UploadLimits": {
    "MaxFileBytes": 10737418240,
    "PartSizeBytes": 8388608,
    "UploadSessionExpiryHours": 24,
    "TrashRetentionDays": 30
  },
  "SearchBench": {
    "P95MaxMilliseconds": 500,
    "DefaultSeedCount": 1000000
  },
  "Backup": {
    "RootPath": ".data/backups",
    "RetainDaily": 7,
    "RetainWeekly": 4,
    "RetainMonthly": 3,
    "PgDumpPath": "pg_dump",
    "PgRestorePath": "pg_restore",
    "LowDiskBytes": 1073741824,
    "RestoreViaAdmin": true
  },
  "Maintenance": {
    "Enabled": false
  },
  "Operations": {
    "PublicUrl": "http://localhost:5048"
  },
  "DisableBackgroundJobs": false
}
