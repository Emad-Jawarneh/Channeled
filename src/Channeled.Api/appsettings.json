{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MigrateOnStartup": true,
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=channeled;Username=channeled;Password=channeled_dev"
  },
  "FileStore": {
    "Kind": "FileSystem",
    "RootPath": ".data/object-store"
  },
  "UploadLimits": {
    "MaxFileBytes": 10737418240,
    "PartSizeBytes": 8388608,
    "UploadSessionExpiryHours": 24,
    "TrashRetentionDays": 30
  },
  "SearchBench": {
    "P95MaxMilliseconds": 500,
    "DefaultSeedCount": 1000000
  },
  "DisableBackgroundJobs": false
}
